# =====================================================================
# FAT — production environment template.
# Copy to `.env` (repo-root) for the pm2/systemd path, or to
# `.env.production` for the Docker Compose path, then fill in real values.
# NEVER commit the filled-in file.
# =====================================================================

# --- Database -------------------------------------------------------
# For Docker Compose, DATABASE_HOST must be the compose service name: `postgres`.
# For the pm2/systemd path (DB on the same host), use `localhost`.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=fat
DATABASE_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_NAME=fat

# --- Backend --------------------------------------------------------
BACKEND_PORT=3001

# --- Auth (MUST change both) ---------------------------------------
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# --- Administrator bootstrap (created by `seed`, run once) ----------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Background jobs (optional) -------------------------------------
# Leave unset to run jobs inline (fine for a single instance).
# For Docker Compose set REDIS_HOST=redis; for a local Redis use localhost.
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Frontend -------------------------------------------------------
# Baked into the Next.js bundle AT BUILD TIME. Must be the public URL the
# browser will call. With the nginx config in deploy/nginx.conf this is
# your domain plus /api. Rebuild the frontend whenever you change it.
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
